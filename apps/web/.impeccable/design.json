    "components": [
        {
            "name": "Primary Button",
            "kind": "button",
            "refersTo": "button-primary",
            "description": "The yellow sticker action: one per view (Agregar al carrito, Ir a pagar).",
            "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"20\" r=\"1\"/><circle cx=\"18\" cy=\"20\" r=\"1\"/><path d=\"M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6\"/></svg>Agregar al carrito</button>",
            "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 16px;border-radius:var(--radius-control,4px);font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;font-size:1rem;letter-spacing:0.025em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 150ms ease,border-color 150ms ease,color 150ms ease;}.ds-btn:active{transform:scale(0.97);}.ds-btn:focus-visible{outline:2px solid #9cc8d6;outline-offset:2px;}.ds-btn-primary{border:0;background:#f2c230;color:#1a1405;box-shadow:0 3px 8px -2px rgb(0 0 0 / 0.55);}.ds-btn-primary:hover{background:#f7d35c;}"
        },
        {
            "name": "Secondary Button",
            "kind": "button",
            "refersTo": "button-secondary",
            "description": "A melamine key for every other action.",
            "html": "<button class=\"ds-btn ds-btn-secondary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"20\" r=\"1\"/><circle cx=\"18\" cy=\"20\" r=\"1\"/><path d=\"M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6\"/></svg>Agregar</button>",
            "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 16px;border-radius:var(--radius-control,4px);font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;font-size:1rem;letter-spacing:0.025em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 150ms ease,border-color 150ms ease,color 150ms ease;}.ds-btn:active{transform:scale(0.97);}.ds-btn:focus-visible{outline:2px solid #9cc8d6;outline-offset:2px;}.ds-btn-secondary{border:1px solid #4a5564;background:#262e39;color:#ece7dc;}.ds-btn-secondary:hover{border-color:#8a94a1;background:#1d232c;}"
        },
        {
            "name": "Ghost Button",
            "kind": "button",
            "refersTo": "button-ghost",
            "description": "A bare caps label for quiet links that look like actions (Ver ficha, Ver todo).",
            "html": "<button class=\"ds-btn ds-btn-ghost\">Ver ficha</button>",
            "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 16px;border-radius:var(--radius-control,4px);font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;font-size:1rem;letter-spacing:0.025em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 150ms ease,border-color 150ms ease,color 150ms ease;}.ds-btn:active{transform:scale(0.97);}.ds-btn:focus-visible{outline:2px solid #9cc8d6;outline-offset:2px;}.ds-btn-ghost{border:0;background:transparent;color:#a7afb9;}.ds-btn-ghost:hover{color:#ece7dc;}"
        },
        {
            "name": "Text Field",
            "kind": "input",
            "refersTo": "input-text",
            "description": "The one text field look; the border turns CRT blue on focus.",
            "html": "<label class=\"ds-field\"><span>Correo</span><input class=\"ds-input\" type=\"email\" placeholder=\"tu@correo.cl\"></label>",
            "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family:'Barlow',sans-serif;font-size:0.875rem;color:#a7afb9;max-width:320px;}.ds-input{height:44px;padding:0 12px;border-radius:4px;border:1px solid #4a5564;background:#1d232c;color:#ece7dc;font:inherit;font-size:1rem;}.ds-input::placeholder{color:#8a94a1;}.ds-input:focus{border-color:#9cc8d6;outline:none;}"
        },
        {
            "name": "Navigation Bar",
            "kind": "nav",
            "refersTo": "",
            "description": "Back-room bar of condensed caps links grouped by thin seams.",
            "html": "<nav class=\"ds-nav\"><a class=\"is-current\" href=\"#\">Catálogo</a><span class=\"ds-seam\"></span><a href=\"#\">PlayStation</a><a href=\"#\">Xbox</a><a href=\"#\">Nintendo</a><span class=\"ds-seam\"></span><a href=\"#\">Claves digitales</a></nav>",
            "css": ".ds-nav{display:flex;align-items:center;gap:0;background:#141922;border-top:1px solid #313a47;padding:0 8px;}.ds-nav a{display:flex;align-items:center;height:44px;padding:0 12px;font-family:'Barlow Condensed',sans-serif;font-weight:700;letter-spacing:0.025em;text-transform:uppercase;color:#a7afb9;text-decoration:none;transition:color 150ms;}.ds-nav a:hover,.ds-nav a.is-current{color:#ece7dc;}.ds-nav a:focus-visible{outline:2px solid #9cc8d6;outline-offset:2px;}.ds-seam{width:1px;height:16px;margin:0 4px;background:#313a47;}"
        },
        {
            "name": "Price Sticker",
            "kind": "chip",
            "refersTo": "price-sticker",
            "description": "Yellow CLP sticker, rotated and overlapping the cover; grey with 'Sin stock' when out of stock.",
            "html": "<div style=\"display:flex;gap:24px;align-items:center\"><p class=\"ds-sticker\">$14.990</p><p class=\"ds-sticker ds-sticker-out\">$79.990<span>Sin stock</span></p></div>",
            "css": ".ds-sticker{display:inline-flex;flex-direction:column;margin:0;padding:4px 8px;border-radius:4px;background:#f2c230;color:#1a1405;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.125rem;line-height:1;font-variant-numeric:tabular-nums;transform:rotate(-3deg);box-shadow:0 3px 8px -2px rgb(0 0 0 / 0.55);}.ds-sticker-out{background:#262e39;color:#a7afb9;}.ds-sticker span{margin-top:2px;font-size:0.75rem;font-weight:500;letter-spacing:0.025em;text-transform:uppercase;}"
        },
        {
            "name": "Station Card",
            "kind": "card",
            "refersTo": "product-cover",
            "description": "A product as a numbered station: generated cover, sticker, PC number and three fixed fact slots.",
            "html": "<article class=\"ds-station\"><div class=\"ds-cover\"><p class=\"ds-band\">PS5</p><p class=\"ds-ctitle\">Neon Heist</p><p class=\"ds-cfoot\">Clave digital · LATAM</p><p class=\"ds-sticker\">$74.990</p></div><p class=\"ds-pc\">PC 04</p><h3><a href=\"#\">Neon Heist</a></h3><dl><dd class=\"w\">PS5</dd><dd>Clave digital</dd><dd class=\"r\">LATAM</dd><dd class=\"w f\">Se activa en PlayStation Store</dd></dl></article>",
            "css": ".ds-station{width:200px;display:flex;flex-direction:column;gap:12px;font-family:'Barlow',sans-serif;color:#ece7dc;}.ds-cover{position:relative;aspect-ratio:3/4;border-radius:6px;background:#6b2d3a;display:flex;flex-direction:column;box-shadow:0 24px 48px -24px rgb(0 0 0 / 0.7),0 2px 6px rgb(0 0 0 / 0.35);transition:transform 260ms cubic-bezier(0.23,1,0.32,1),box-shadow 200ms;}.ds-station:hover .ds-cover{transform:perspective(900px) rotateX(-2deg) rotateY(3deg) translateY(-4px);box-shadow:0 18px 32px -12px rgb(0 0 0 / 0.65),0 4px 10px rgb(0 0 0 / 0.4);}.ds-band{margin:0;padding:4% 8%;background:rgb(15 19 25 / 0.55);border-radius:6px 6px 0 0;font:700 0.75rem 'Barlow Condensed',sans-serif;letter-spacing:0.05em;text-transform:uppercase;}.ds-ctitle{margin:auto 0 0;padding:0 8%;font:700 1.75rem/0.92 'Barlow Condensed',sans-serif;text-transform:uppercase;}.ds-cfoot{margin:0;padding:5% 8% 7%;font-size:0.65rem;font-weight:500;letter-spacing:0.025em;text-transform:uppercase;opacity:0.9;}.ds-cover .ds-sticker{position:absolute;right:-6px;bottom:-8px;display:inline-block;margin:0;padding:4px 8px;border-radius:4px;background:#f2c230;color:#1a1405;font:700 1.125rem/1 'Barlow Condensed',sans-serif;transform:rotate(-3deg);box-shadow:0 3px 8px -2px rgb(0 0 0 / 0.55);}.ds-pc{margin:0 0 -8px;padding-top:4px;font:400 0.75rem 'JetBrains Mono',monospace;color:#8a94a1;}.ds-station h3{margin:0;font-size:1rem;font-weight:600;}.ds-station a{color:#ece7dc;text-decoration:none;}.ds-station a:hover{color:#f2c230;}.ds-station dl{margin:0;display:grid;grid-template-columns:auto 1fr;column-gap:12px;font-size:0.875rem;color:#a7afb9;}.ds-station dd{margin:0;}.ds-station .w{grid-column:span 2;}.ds-station dd.w:first-child{color:#ece7dc;}.ds-station .r{text-align:right;}.ds-station .f{color:#8a94a1;}"
        },
        {
            "name": "Thermal Receipt",
            "kind": "custom",
            "refersTo": "thermal-receipt",
            "description": "Cream paper with torn zig-zag edges and monospace print for every money summary.",
            "html": "<div class=\"ds-receipt\"><p class=\"ds-rhead\">NextKeys · Detalle</p><p class=\"ds-row\"><span>3 × Starfall</span><span>$65.970</span></p><p class=\"ds-row ds-total\"><span>Total estimado</span><span>$305.940</span></p></div>",
            "css": ".ds-receipt{--tear:8px;width:300px;padding:calc(var(--tear) + 1.25rem) 24px;background:#efe8d8;color:#22201b;font:400 0.875rem/1.5 'JetBrains Mono',monospace;mask:conic-gradient(from -45deg at bottom,#0000,#000 1deg 90deg,#0000 91deg) bottom/var(--tear) 51% repeat-x,conic-gradient(from 135deg at top,#0000,#000 1deg 90deg,#0000 91deg) top/var(--tear) 51% repeat-x;filter:drop-shadow(0 12px 18px rgb(0 0 0 / 0.45));}.ds-rhead{margin:0 0 12px;padding-bottom:12px;border-bottom:1px dashed #cfc6b2;text-align:center;font-size:0.75rem;letter-spacing:0.2em;text-transform:uppercase;color:#5d5749;}.ds-row{display:flex;justify-content:space-between;margin:4px 0;font-variant-numeric:tabular-nums;}.ds-total{margin-top:12px;padding-top:12px;border-top:1px dashed #cfc6b2;font-weight:600;font-size:1rem;}"
        },
        {
            "name": "Whiteboard",
            "kind": "custom",
            "refersTo": "whiteboard",
            "description": "Home-only price board in marker with dotted leaders and the deal of the day.",
            "html": "<aside class=\"ds-board\"><h2>Precios de hoy</h2><a href=\"#\"><span>Shield Antivirus</span><i></i><b>$14.990</b></a><a href=\"#\"><span>Starfall</span><i></i><b>$19.990</b></a></aside>",
            "css": ".ds-board{width:300px;padding:20px;border:4px solid #262e39;border-radius:6px;background:#e6e9e4;color:#1d2b4a;font-family:'Barlow',sans-serif;box-shadow:0 24px 48px -24px rgb(0 0 0 / 0.7),0 2px 6px rgb(0 0 0 / 0.35);}.ds-board h2{margin:0 0 8px;font:400 1.875rem 'Permanent Marker',cursive;}.ds-board a{display:flex;align-items:baseline;gap:8px;padding:8px 0;border-bottom:1px solid #c6ccc5;color:inherit;text-decoration:none;font-weight:600;}.ds-board a:hover{color:#b3362b;}.ds-board i{flex:1;align-self:flex-end;margin-bottom:4px;border-bottom:2px dotted #c6ccc5;}.ds-board b{font:700 1.25rem 'Barlow Condensed',sans-serif;font-variant-numeric:tabular-nums;}"
        }
    ],
    "narrative": {
        "northStar": "The Cibercafé Counter at Midnight",
        "overview": "The storefront is the counter of a Chilean neighborhood cibercafé after dark. The room is a cool ink ground with dark melamine panels; the only bright zone is the glass display case lit by a tube from above, where game boxes stand on a glass shelf wearing yellow price stickers. Behind the counter hangs a whiteboard written in marker with today's prices, and every purchase prints as a cream thermal receipt with torn edges. Each material has one job, and each job always uses the same material.\n\nDensity is that of a working shop, not a showroom: one strict grid of numbered stations (\"PC 01\", \"PC 02\"), each with the cover on top and platform, type, region and activation in fixed slots below. Covers lead every listing at 3:4 game-case proportion. When a product has no uploaded cover, the system prints one from its own data: a deep per-product tint, a platform band, the title in condensed caps, type and region at the foot. Motion is soft and physical. Covers tilt toward the pointer like a box picked up from the shelf, buttons press to 0.97, lists rise in with a short stagger, and everything falls back to opacity and color under `prefers-reduced-motion`.\n\nThe world refuses the category default for game-key stores: a black page with a single neon accent and a carousel hero. Light comes from objects (the case, the sticker, the CRT glow), never from neon gradients.",
        "keyCharacteristics": [
            "Night-room ink ground; the display case is the only lit zone.",
            "Sticker yellow marks prices and the one primary action per view.",
            "CRT blue means \"active\" and \"focused\", nothing else.",
            "Thermal paper and monospace for every money summary: cart, checkout, payment result, order.",
            "Condensed signage caps for headings and buttons, a plain sans for reading, marker only on the whiteboard.",
            "Numbered stations on one grid, facts always in the same slot."
        ],
        "rules": [
            {
                "name": "The One Sticker Rule",
                "body": "Yellow fills only price stickers and the single primary action of a view. A second yellow button on the same screen means one of them is secondary.",
                "section": "colors"
            },
            {
                "name": "The Signal Rule",
                "body": "CRT blue means focus or \"you are here\". Do not use it for decoration or for prices.",
                "section": "colors"
            },
            {
                "name": "The Material Rule",
                "body": "Paper belongs to receipts, the board to the whiteboard, cover tints to covers. A material never leaves its object.",
                "section": "colors"
            },
            {
                "name": "The Tabular Price Rule",
                "body": "Every price, count, countdown and reference uses tabular figures (`data`, `time` and `.tabular` get them by default) and comes from the API in CLP.",
                "section": "typography"
            },
            {
                "name": "The Marker Stays on the Board Rule",
                "body": "Permanent Marker appears only on the whiteboard. Nowhere else is hand-written.",
                "section": "typography"
            },
            {
                "name": "The One Lit Zone Rule",
                "body": "Only the display case receives the overhead light treatment. Other sections stay flat on the room's tonal steps.",
                "section": "elevation"
            },
            {
                "name": "The Shadow Follows the Object Rule",
                "body": "Shadows belong to things you could pick up. Panels, nav bars and form sections have borders, not shadows.",
                "section": "elevation"
            }
        ],
        "dos": [
            "**Do** keep the page on Night Room (#0f1319) and let only the display case carry the overhead light.",
            "**Do** put every price on a Sticker Yellow sticker or in tabular figures, in CLP from the API.",
            "**Do** print every money summary (cart, checkout, result, order) on the thermal receipt in JetBrains Mono.",
            "**Do** keep a product's facts in the same slots everywhere: platforms, then type and region, then activation.",
            "**Do** use CRT blue (#9cc8d6) for focus rings and focused borders on every interactive element.",
            "**Do** give pressable elements the 0.97 press and reduce all motion to opacity and color under `prefers-reduced-motion`.",
            "**Do** stagger list entrances with the motion helper (0, 40, 70, 95… ms, capped at 150ms) and the 260ms rise."
        ],
        "donts": [
            "**Don't** use more than one Sticker Yellow action per view.",
            "**Don't** add neon gradients, glowing accents or a carousel hero; light comes from the case tube and the objects in it.",
            "**Don't** use Permanent Marker outside the whiteboard, or paper and board colors outside their objects.",
            "**Don't** show \"before\" prices, invented discounts, ratings or reviews.",
            "**Don't** put shadows on panels, nav bars or form sections; use borders and tonal steps.",
            "**Don't** use white text on Sticker Yellow; text on it is Sticker Ink."
        ]
    }
}
