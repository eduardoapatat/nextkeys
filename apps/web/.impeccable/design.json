        {
            "name": "Primary Button",
            "kind": "button",
            "refersTo": "button-primary",
            "description": "The coral action, one per view (Agregar al carrito, Ir a pagar).",
            "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"20\" r=\"1\"/><circle cx=\"18\" cy=\"20\" r=\"1\"/><path d=\"M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6\"/></svg>Agregar al carrito</button>",
            "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 16px;border-radius:var(--radius-control,4px);font-family:'Sofia Sans Condensed','Rubik',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.025em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 150ms ease,border-color 150ms ease,color 150ms ease;}.ds-btn:active{transform:scale(0.97);}.ds-btn:focus-visible{outline:2px solid var(--color-brand,#1e758a);outline-offset:2px;}.ds-btn-primary{border:0;background:var(--color-accent,#e04a2a);color:var(--color-accent-fg,#ffffff);box-shadow:0 3px 8px -2px rgb(11 31 51 / 0.35);}.ds-btn-primary:hover{background:var(--color-accent-hover,#c93f22);}"
